generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SmsStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AttemptStatus {
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet   Wallet?
  messages SmsMessage[]
}

model Wallet {
  id        String   @id @default(uuid())
  balance   Int      @default(1000)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Provider {
  id          String   @id @default(uuid())
  name        String   @unique
  priority    Int
  balance     Int      @default(10000)
  failureRate Float    @default(0.3)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts    SmsAttempt[]
  smsMessages SmsMessage[] @relation("SelectedProvider")
}

model SmsMessage {
  id         String    @id @default(uuid())
  recipient  String
  message    String
  parts      Int       @default(1)
  cost       Int       @default(0)
  status     SmsStatus @default(PENDING)
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  selectedProviderId String?
  selectedProvider   Provider? @relation("SelectedProvider", fields: [selectedProviderId], references: [id], onDelete: SetNull)

  attempts SmsAttempt[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([recipient])
}

model SmsAttempt {
  id          String        @id @default(uuid())
  status      AttemptStatus
  response    String?
  error       String?
  attemptedAt DateTime      @default(now())

  smsMessageId String
  smsMessage   SmsMessage @relation(fields: [smsMessageId], references: [id], onDelete: Cascade)

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([smsMessageId, attemptedAt])
  @@index([providerId, attemptedAt])
}
